FINAL_CACHE = []


def FIFO(pages, capacity):
    global FINAL_CACHE

    cache = []
    hits = 0
    misses = 0

    for data in pages:
        if data in cache:
            hits += 1
        else:
            misses += 1

            if len(cache) == capacity:
                cache.pop(0)

            cache.append(data)

    FINAL_CACHE = cache.copy()

    return hits, misses
